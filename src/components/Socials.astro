---
/**
 * Socials — Renders the author's social media profile links (e.g. GitHub, LinkedIn, Twitter).
 * It dynamically maps over the SOCIALS array defined in `constants.ts`.
 * Typically used in the Footer or Author bio sections.
 */
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="social-link p-2 sm:p-1"
        title={social.linkTitle}
        target="_blank"
        rel="noopener noreferrer"
      >
        <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>

<style>
  :global(.social-link) {
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  :global(.social-link:hover) {
    transform: translateY(-2px) scale(1.1);
    filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.6));
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.social-link) {
      transition: none;
    }
    :global(.social-link:hover) {
      transform: none;
      filter: none;
    }
  }
</style>
